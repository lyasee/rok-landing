---
import { existsSync, readFileSync } from "node:fs";
import path from "node:path";
const base = "/images/pogeun-diary/concepts/2026-09-10";
const cards = [
  { id: "01-diary-concept", title: "귀여운 하루를 기록해요" },
  { id: "02-stickers-concept", title: "스티커로 감정을 남겨요" },
  { id: "03-papers-concept", title: "예쁜 속지와 테마" },
  { id: "04-calendar-concept", title: "한눈에 보는 기록" },
  { id: "05-backup-concept", title: "비밀 일기와 편한 백업" },
];
const assetFile = (relative: string) =>
  path.join(process.cwd(), "public", base, relative);
let ready = false;
try {
  const manifest = JSON.parse(readFileSync(assetFile("manifest.json"), "utf8"));
  ready =
    manifest.kind === "generated-concept" &&
    manifest.isActualAppScreenshot === false &&
    cards.every(({ id }) =>
      [480, 941].every((size) =>
        existsSync(assetFile(`web/${id}-${size}.webp`)),
      ),
    );
} catch {
  /* No broken images or substitution before the verified import. */
}
---

{
  ready && (
    <section
      class="pd-concepts pd-shell"
      id="concepts"
      aria-labelledby="pd-concepts-title"
    >
      <div class="pd-concept-heading">
        <p class="pd-kicker">POGEUN MOOD BOARD</p>
        <h2 id="pd-concepts-title">
          그림으로 만나는
          <br />
          포근한 분위기.
        </h2>
        <p class="pd-concept-notice">
          <strong>AI 생성 홍보 시안 · 실제 앱 캡처 아님</strong>
          앱의 분위기를 표현한 이미지입니다. 그림체, 화면 구성과 기능 표현은
          현재 앱과 다릅니다. 실제 기능과 조작 화면은{" "}
          <a href="#screens">실제 앱 화면 영역</a>에서 확인해 주세요.
        </p>
      </div>
      <p class="pd-concept-help">
        옆으로 넘겨보고, 이미지를 누르면 새 탭에서 크게 볼 수 있어요.
      </p>
      <div
        class="pd-concept-track"
        role="region"
        aria-label="홍보 시안 5장"
        tabindex="0"
      >
        {cards.map((card, index) => (
          <figure class="pd-concept-card">
            <a
              href={`${base}/web/${card.id}-941.webp`}
              target="_blank"
              rel="noopener"
              aria-label={`${card.title} 홍보 시안 크게 보기, 새 탭`}
            >
              <span class="pd-concept-badge">홍보 시안</span>
              <img
                src={`${base}/web/${card.id}-480.webp`}
                srcset={`${base}/web/${card.id}-480.webp 480w, ${base}/web/${card.id}-941.webp 941w`}
                sizes="(max-width: 600px) 78vw, (max-width: 980px) 40vw, 220px"
                width="941"
                height="1672"
                loading="lazy"
                decoding="async"
                alt={`${card.title} — AI 생성 홍보 시안이며 실제 앱 화면이 아닙니다.`}
              />
            </a>
            <figcaption>
              <span>0{index + 1}</span>
              <strong>{card.title}</strong>
              <small>AI 생성 이미지 · 실제 화면과 다름</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  .pd-concepts {
    padding-block: 88px 24px;
  }
  .pd-concept-heading h2 {
    margin-top: 16px;
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.3;
  }
  .pd-concept-notice {
    max-width: 740px;
    margin-top: 22px !important;
    color: var(--pd-muted);
    font-size: 14px;
    line-height: 1.85;
  }
  .pd-concept-notice strong {
    display: block;
    color: var(--pd-cocoa);
  }
  .pd-concept-notice a {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .pd-concept-help {
    margin-top: 24px !important;
    color: var(--pd-muted);
    font-size: 12px;
    line-height: 1.7;
  }
  .pd-concept-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(210px, 1fr);
    gap: 18px;
    overflow-x: auto;
    padding: 22px 2px 16px;
    scroll-snap-type: x proximity;
  }
  .pd-concept-track:focus-visible {
    outline: 2px solid var(--pd-blush-deep);
    outline-offset: 5px;
  }
  .pd-concept-card {
    min-width: 0;
    scroll-snap-align: start;
  }
  .pd-concept-card a {
    position: relative;
    display: block;
    border: 1px solid var(--pd-line);
    border-radius: 18px;
    background: var(--pd-paper);
  }
  .pd-concept-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 941 / 1672;
    object-fit: contain;
    border-radius: 17px;
  }
  .pd-concept-badge {
    position: absolute;
    z-index: 1;
    left: 10px;
    top: 10px;
    padding: 6px 10px;
    border-radius: 99px;
    background: #fffdf8;
    color: #654d44;
    font-size: 11px;
    box-shadow: 0 2px 8px #5b433b18;
  }
  .pd-concept-card figcaption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 5px 8px;
    padding: 14px 2px 0;
    font-size: 13px;
    line-height: 1.6;
  }
  .pd-concept-card figcaption span {
    grid-row: span 2;
    color: var(--pd-blush-deep);
  }
  .pd-concept-card figcaption small {
    color: var(--pd-muted);
    font-size: 10px;
  }
  @media (max-width: 980px) {
    .pd-concept-track {
      grid-auto-columns: minmax(220px, 40%);
    }
  }
  @media (max-width: 600px) {
    .pd-concept-track {
      grid-auto-columns: 82%;
      gap: 14px;
    }
    .pd-concepts {
      padding-top: 66px;
    }
  }
</style>
